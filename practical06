#include <iostream>
using namespace std;

int main()
{
    int p[4];
    int m[4][4];

    cout << "Enter dimensions of 3 matrices: ";
    cin >> p[0] >> p[1] >> p[2] >> p[3];

    // Initialize diagonal elements
    // Multiplying one matrix needs 0 operations
    for (int i = 1; i <= 3; i++)
    {
        m[i][i] = 0;
    }

    // Find minimum cost
    for (int length = 2; length <= 3; length++)
    {
        for (int i = 1; i <= 3 - length + 1; i++)
        {
            int j = i + length - 1;

            m[i][j] = 9999;

            // Try every possible split k
            for (int k = i; k < j; k++)
            {
                int cost = m[i][k]
                         + m[k + 1][j]
                         + p[i - 1] * p[k] * p[j];

                if (cost < m[i][j])
                {
                    m[i][j] = cost;
                }
            }
        }
    }

    cout << "\nMinimum multiplication cost = "
         << m[1][3] << endl;

    return 0;
}
