#include <iostream>
#include <vector>
#include <climits>

using namespace std;

int main() {
    int amount, n;

    cout << "Enter amount: ";
    cin >> amount;

    cout << "Enter number of coins: ";
    cin >> n;

    vector<int> coins(n);

    cout << "Enter coin values: ";
    for (int i = 0; i < n; i++) {
        cin >> coins[i];
    }

    // dp[i] = minimum number of coins needed to make amount i
    vector<int> dp(amount + 1, INT_MAX);

    dp[0] = 0;

    // Calculate minimum coins for every amount
    for (int i = 1; i <= amount; i++) {

        for (int coin : coins) {

            if (coin <= i && dp[i - coin] != INT_MAX) {
                dp[i] = min(dp[i], dp[i - coin] + 1);
            }
        }
    }

    if (dp[amount] == INT_MAX)
        cout << "Amount cannot be formed using given coins.";
    else
        cout << "Minimum number of coins: " << dp[amount];

    return 0;
}
