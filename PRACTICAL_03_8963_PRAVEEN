#include <iostream>
#include <vector>
#include <chrono>
#include <cstdlib>
#include <ctime>
#include <algorithm>

using namespace std;
using namespace std::chrono;

//---------------- MAX HEAP ----------------//
void buildMax(vector<int> &a, int size, int root)
{
    int maxIndex = root;
    int l = 2 * root + 1;
    int r = 2 * root + 2;

    if (l < size && a[l] > a[maxIndex])
        maxIndex = l;

    if (r < size && a[r] > a[maxIndex])
        maxIndex = r;

    if (maxIndex != root)
    {
        swap(a[root], a[maxIndex]);
        buildMax(a, size, maxIndex);
    }
}

void heapSortMax(vector<int> &a)
{
    int size = a.size();

    for (int i = size / 2 - 1; i >= 0; i--)
        buildMax(a, size, i);

    for (int i = size - 1; i > 0; i--)
    {
        swap(a[0], a[i]);
        buildMax(a, i, 0);
    }
}

//---------------- MIN HEAP ----------------//
void buildMin(vector<int> &a, int size, int root)
{
    int minIndex = root;
    int l = 2 * root + 1;
    int r = 2 * root + 2;

    if (l < size && a[l] < a[minIndex])
        minIndex = l;

    if (r < size && a[r] < a[minIndex])
        minIndex = r;

    if (minIndex != root)
    {
        swap(a[root], a[minIndex]);
        buildMin(a, size, minIndex);
    }
}

void heapSortMin(vector<int> &a)
{
    int size = a.size();

    for (int i = size / 2 - 1; i >= 0; i--)
        buildMin(a, size, i);

    for (int i = size - 1; i > 0; i--)
    {
        swap(a[0], a[i]);
        buildMin(a, i, 0);
    }

    reverse(a.begin(), a.end());
}

//---------------- MAIN ----------------//
int main()
{
    int n;

    cout << "Enter number of elements: ";
    cin >> n;

    vector<int> data(n);

    srand((unsigned)time(NULL));

    for (int i = 0; i < n; i++)
        data[i] = rand() % 100000;

    vector<int> maxData = data;
    vector<int> minData = data;

    auto start1 = high_resolution_clock::now();
    heapSortMax(maxData);
    auto stop1 = high_resolution_clock::now();

    auto start2 = high_resolution_clock::now();
    heapSortMin(minData);
    auto stop2 = high_resolution_clock::now();

    auto maxNano = duration_cast<nanoseconds>(stop1 - start1);
    auto maxMicro = duration_cast<microseconds>(stop1 - start1);

    auto minNano = duration_cast<nanoseconds>(stop2 - start2);
    auto minMicro = duration_cast<microseconds>(stop2 - start2);

    cout << "\n========== MAX HEAP SORT ==========\n";
    cout << "Nanoseconds  : " << maxNano.count() << " ns\n";
    cout << "Microseconds : " << maxMicro.count() << " us\n";

    cout << "\n========== MIN HEAP SORT ==========\n";
    cout << "Nanoseconds  : " << minNano.count() << " ns\n";
    cout << "Microseconds : " << minMicro.count() << " us\n";

    return 0;
}
